# --- Access -------------------------------------------------------------
# A shared password over the whole dashboard. Not per-person auth: one
# password is given to whoever needs access. With this unset the app is open
# in development and LOCKED in production, so forgetting it cannot publish
# candidate data by accident.
APP_PASSWORD=
# Signs the session cookie. Any long random string; defaults to APP_PASSWORD.
AUTH_SECRET=
# AUTH_SESSION_DAYS=7

# --- Model provider -----------------------------------------------------
# Pick one. If both keys are present, ANTHROPIC wins unless MODEL_PROVIDER
# says otherwise. The brief specifies the Claude API; Gemini is supported
# because that is the key available here.
# MODEL_PROVIDER=gemini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_DRAFT_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Sending ------------------------------------------------------------
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM="Arjun Mehta <arjun@yourdomain.com>"
# RESEND_REPLY_TO=arjun@yourdomain.com

# --- Scheduling ---------------------------------------------------------
# SIMPLEST OPTION, and the one that actually lets a candidate choose:
# a Google Calendar Appointment Schedule's public booking page. Create one by
# hand in Google Calendar (Create -> Appointment schedule), publish it, paste
# the URL here. There is no API for these, so it is one fixed link. When set,
# it is used instead of the free/busy slot list below.
BOOKING_URL=

# --- Scheduling (fallback) ----------------------------------------------
# Google Calendar. The app READS free/busy and offers open interview slots in
# the acceptance email; it never writes to the calendar and never sends an
# invite. Scope is calendar.readonly for that reason.
#
# 1. console.cloud.google.com -> new project -> enable the Calendar API
# 2. OAuth consent screen: choose Internal if you have Google Workspace
#    (External + Testing expires the refresh token every 7 days)
# 3. Credentials -> OAuth client ID -> "Desktop app"
# 4. npx tsx scripts/google-auth.mjs, then paste the refresh token below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# Slot shape. Defaults suit a Mumbai working day.
# INTERVIEW_TIMEZONE=Asia/Kolkata
# INTERVIEW_MINUTES=45
# INTERVIEW_DAY_START=10
# INTERVIEW_DAY_END=18
# INTERVIEW_LOOKAHEAD_DAYS=10
# INTERVIEW_MAX_SLOTS=6
# INTERVIEW_MIN_NOTICE_HOURS=24

# Calendly is still supported and used only if Google Calendar is unconfigured.
CALENDLY_API_KEY=
CALENDLY_EVENT_TYPE_URI=

# --- Storage ------------------------------------------------------------
# Unset  -> JSON files under data/ (local development only).
# Set    -> Postgres. REQUIRED on Vercel: its filesystem is read-only, so
#           without this every decision is lost between requests.
# Neon gives you this string; the Vercel integration injects it automatically.
# Create the tables once with db/schema.sql.
DATABASE_URL=

# Test mode. When set, EVERY message goes to this one address and no address
# is read from any CV. Thirty of the CVs are real people who never applied
# here; testing the send path must not be one mistyped recipient away from
# reaching them. Enforced in /api/decide and again in /api/send.
SEND_OVERRIDE_TO=

# --- Testing ------------------------------------------------------------
# Set to 1 to run batches with a canned response instead of calling the API.
# RANK_STUB=1

# --- Model provider -----------------------------------------------------
# Pick one. If both keys are present, ANTHROPIC wins unless MODEL_PROVIDER
# says otherwise. The brief specifies the Claude API; Gemini is supported
# because that is the key available here.
# MODEL_PROVIDER=gemini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_DRAFT_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Sending ------------------------------------------------------------
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM="Arjun Mehta <arjun@yourdomain.com>"
# RESEND_REPLY_TO=arjun@yourdomain.com

# --- Scheduling ---------------------------------------------------------
# One Event Type, shared by both roles.
CALENDLY_API_KEY=
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/XXXXXXXX

# --- Storage ------------------------------------------------------------
# Unset  -> JSON files under data/ (local development only).
# Set    -> Postgres. REQUIRED on Vercel: its filesystem is read-only, so
#           without this every decision is lost between requests.
# Neon gives you this string; the Vercel integration injects it automatically.
# Create the tables once with db/schema.sql.
DATABASE_URL=

# --- Testing ------------------------------------------------------------
# Set to 1 to run batches with a canned response instead of calling the API.
# RANK_STUB=1
